generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                String    @id @default(uuid())
  email             String    @unique
  nombre            String    @unique
  password          String
  oro               Int       @default(10)
  madera            Int       @default(0)
  piedra            Int       @default(0)
  metal             Int       @default(0)
  baseCoords        Json?
  ultimaMisionElite DateTime?
  ultimaActividad   DateTime?
  fechaCreacion DateTime @default(now())

  edificios Json @default("{\"taberna\": 1, \"herreria\": 0, \"mercado\": 0, \"embajada\": 0}")

  // Relaciones
  personaje        Personaje?
  expedicionActiva ExpedicionActiva?
  historial        RegistroAccion[]
  sesiones         Sesion[]
  mensajesChat     MensajeChat[]
  sugerencias      Sugerencia[]

  partyLiderada             Party[]         @relation("PartyLider")
  partyMembresia             PartyMember?
  trasladosComoVisitante     PartyTransfer[] @relation("TransferVisitante")
  trasladosComoAnfitrion     PartyTransfer[] @relation("TransferAnfitrion")
}

model Sesion {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expira    DateTime
  creada    DateTime @default(now())

  @@index([usuarioId])
  @@index([expira])
}

model Personaje {
  id        String  @id @default(uuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  // "clase" se conserva temporalmente para compatibilidad con el combate legado.
  clase              String
  profesionActivaId  String               @default("novato")
  sexo               String               @default("chico")
  nombre             String
  posicionCombate    String               @default("centro")

  fuerza              Int                  @default(1)
  agilidad            Int                  @default(1)
  vitalidad           Int                  @default(1)
  inteligencia        Int                  @default(1)
  destreza            Int                  @default(1)
  suerte              Int                  @default(1)
  puntosAtributoDisponibles Int             @default(0)
  energiaActual       Int                  @default(20)
  manaActual          Int                  @default(10)

  hpActual           Int
  comidaPreparada    String?
  estado             String               @default("ocioso")

  velocidadMejoras           Int @default(0)
  capacidadCarruajeMejoras   Int @default(0)

  nivel              Int                  @default(1)
  experiencia        Int                  @default(0)

  inventario         Inventario?
  habilidades        HabilidadAprendida[]
  equipoEquipado     EquipoEquipado?
  progresosClase     ProgresoClase[]
  rangosAmenazaCompletados Json @default("[]")
}

model ProgresoClase {
  id                         String   @id @default(uuid())
  personajeId                String
  claseId                    String
  nivelJob                   Int      @default(1)
  experienciaJob             Int      @default(0)
  puntosHabilidadDisponibles  Int      @default(0)
  desbloqueada               Boolean  @default(false)
  maestriaCompletada         Boolean  @default(false)
  creado                     DateTime @default(now())
  actualizado                DateTime @updatedAt

  personaje Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)

  @@unique([personajeId, claseId])
  @@index([personajeId, desbloqueada])
  @@index([claseId, nivelJob])
}

model Inventario {
  id          String    @id @default(uuid())
  personajeId String    @unique
  personaje   Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)
  // Snapshot de la última venta para permitir una única recompra.
  ultimaVenta Json?

  objetos InventarioObjeto[]
}

model InventarioObjeto {
  id            String @id @default(uuid())
  inventarioId  String
  objetoId      String
  cantidad      Int @default(1)
  nivelMejora   Int @default(0)
  sufijoId      String?
  bonificaciones Json @default("{}")

  inventario Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)

  armaEquipadas             EquipoEquipado[] @relation("ArmaEquipada")
  armaduraEquipadas         EquipoEquipado[] @relation("ArmaduraEquipada")
  accesorioEquipadas        EquipoEquipado[] @relation("AccesorioEquipada")
  manoSecundariaEquipadas   EquipoEquipado[] @relation("ManoSecundariaEquipada")
  cascoEquipadas            EquipoEquipado[] @relation("CascoEquipada")
  pantalonesEquipadas       EquipoEquipado[] @relation("PantalonesEquipada")
  botasEquipadas            EquipoEquipado[] @relation("BotasEquipada")
  guantesEquipadas          EquipoEquipado[] @relation("GuantesEquipada")
  anillo1Equipadas          EquipoEquipado[] @relation("Anillo1Equipada")
  anillo2Equipadas          EquipoEquipado[] @relation("Anillo2Equipada")

  @@index([inventarioId, objetoId])
}

model EquipoEquipado {
  id          String @id @default(uuid())
  personajeId String @unique
  personaje   Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)

  // Diez ranuras: arma (una o dos manos), mano secundaria, casco, torso,
  // pantalones, botas, guantes, collar y dos anillos.
  armaInventarioId             String?
  manoSecundariaInventarioId   String?
  cascoInventarioId            String?
  armaduraInventarioId         String?
  pantalonesInventarioId       String?
  botasInventarioId            String?
  guantesInventarioId          String?
  accesorioInventarioId        String?
  anillo1InventarioId          String?
  anillo2InventarioId          String?

  arma           InventarioObjeto? @relation("ArmaEquipada", fields: [armaInventarioId], references: [id], onDelete: SetNull)
  manoSecundaria InventarioObjeto? @relation("ManoSecundariaEquipada", fields: [manoSecundariaInventarioId], references: [id], onDelete: SetNull)
  casco          InventarioObjeto? @relation("CascoEquipada", fields: [cascoInventarioId], references: [id], onDelete: SetNull)
  armadura       InventarioObjeto? @relation("ArmaduraEquipada", fields: [armaduraInventarioId], references: [id], onDelete: SetNull)
  pantalones     InventarioObjeto? @relation("PantalonesEquipada", fields: [pantalonesInventarioId], references: [id], onDelete: SetNull)
  botas          InventarioObjeto? @relation("BotasEquipada", fields: [botasInventarioId], references: [id], onDelete: SetNull)
  guantes        InventarioObjeto? @relation("GuantesEquipada", fields: [guantesInventarioId], references: [id], onDelete: SetNull)
  accesorio      InventarioObjeto? @relation("AccesorioEquipada", fields: [accesorioInventarioId], references: [id], onDelete: SetNull)
  anillo1        InventarioObjeto? @relation("Anillo1Equipada", fields: [anillo1InventarioId], references: [id], onDelete: SetNull)
  anillo2        InventarioObjeto? @relation("Anillo2Equipada", fields: [anillo2InventarioId], references: [id], onDelete: SetNull)
}

model HabilidadAprendida {
  id          String  @id @default(uuid())
  personajeId String
  habilidadId String
  nivel       Int     @default(1)
  slot        String?

  personaje Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)

  @@unique([personajeId, habilidadId])
  @@unique([personajeId, slot])
}

model ExpedicionActiva {
  id        String  @id @default(uuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo       String
  objetivoId String?
  fase       String
  resultadoFinal     String?

  misionId   String
  enemigoId  String?
  nombre     String
  recompensa Json
  dificultad Int
  modoDificultad String @default("normal")
  efectoComida String?

  hpPerdido          Int      @default(0)
  experienciaGanada  Int      @default(0)

  fechaSalida   DateTime @default(now())
  fechaLlegada  DateTime
  destinoCoords Json

  combateActivo CombateActivo?
}

model CombateActivo {
  id String @id @default(uuid())

  version Int @default(0)

  expedicionId String           @unique
  expedicion   ExpedicionActiva @relation(fields: [expedicionId], references: [id], onDelete: Cascade)

  fase String @default("activo")

  ronda Int @default(1)
  turno String @default("jugador")

  tipo String @default("pve")

  // Posiciones tácticas congeladas al crear el combate.
  jugadorPosicion String @default("centro")
  enemigoPosicion String @default("centro")

 // Solo PvP
  atacanteUsuarioId String?
  defensorUsuarioId String?

  atacanteNombre String?
  defensorNombre String?

  atacanteClase String?
  atacanteSexo String?

  defensorClase String?
  defensorSexo String?

  ultimoTurnoEn DateTime @default(now())

  cooldownsDefensor Json @default("{}")
  efectosDefensor Json @default("[]")

  estadoDefensorAnterior String?

  capacidadCarruaje Int?
  
  // Edificios defensivos
  murallaNivel Int?
  almacenNivel Int?

  enemigoUsuarioId String?

  enemigoId     String?
  enemigoNombre String?

  enemigoHp        Int?
  enemigoHpMaximo  Int?
  enemigoAtaque    Int?
  enemigoAtaqueMagico Int?
  enemigoDefensa   Int?
  enemigoDefensaMagica Int?
  enemigoVelocidad Int?
  enemigoProbCritico Float?
  enemigoDanoCritico Float?
  enemigoPrecision Float @default(75)
  enemigoEvasion Float @default(0)
  enemigoNivel Int?

  jugadorHp       Int
  jugadorHpMaximo Int
  jugadorAtaque   Int
  jugadorAtaqueMagico Int @default(1)
  jugadorDefensa  Int
  jugadorDefensaMagica Int @default(0)
  jugadorVelocidad Int
  jugadorProbCritico Float
  jugadorDanoCritico Float
  jugadorPrecision Float @default(75)
  jugadorEvasion Float @default(0)
  jugadorNivel    Int

  ganadorUsuarioId String?
  botinResuelto Boolean @default(false)

  oroGanado         Int @default(0)
  experienciaGanada Int @default(0)

  cooldowns Json @default("{}")
  efectos   Json @default("[]")
  log       Json @default("[]")

  ultimaAccion Json?

  creado      DateTime @default(now())
  actualizado DateTime @updatedAt

  @@index([defensorUsuarioId])
  @@index([atacanteUsuarioId])
  @@index([tipo, fase])
}

model AfinidadComercial {
  id           String @id @default(uuid())
  jugador1Id   String
  jugador2Id   String
  intercambios Int    @default(0)
  afinidad     Int    @default(0)

  @@unique([jugador1Id, jugador2Id])
}

model RegistroAccion {
  id        String  @id @default(uuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo    String // Ej: "EXPEDICION_TERMINADA", "MEJORA_EDIFICIO", "CURACION"
  detalle String // Ej: "El personaje sanó 20 HP en la taberna por 15 de oro"
  fecha   DateTime @default(now())
}

model MensajeChat {
  id        String   @id @default(uuid())
  usuarioId String
  texto     String
  creado    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([creado])
}

model Sugerencia {
  id        String   @id @default(uuid())
  usuarioId String
  titulo    String
  texto     String
  creado    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([creado])
}



model Party {
  id             String   @id @default(uuid())
  liderUsuarioId String   @unique
  liderUsuario   Usuario  @relation("PartyLider", fields: [liderUsuarioId], references: [id], onDelete: Cascade)
  creado         DateTime @default(now())
  actualizado    DateTime @updatedAt

  miembros PartyMember[]
}

model PartyMember {
  id        String   @id @default(uuid())
  partyId   String
  usuarioId String   @unique
  unidoEn   DateTime @default(now())

  party   Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([partyId, unidoEn])
}

model PartyTransfer {
  id                 String   @id @default(uuid())
  visitanteUsuarioId String
  anfitrionUsuarioId String
  estado             String   @default("en_viaje")
  decision           String?
  fechaSalida        DateTime @default(now())
  fechaLlegada       DateTime
  fechaResolucion    DateTime?
  origenCoords       Json
  destinoCoords      Json
  creado             DateTime @default(now())
  actualizado        DateTime @updatedAt

  visitante Usuario @relation("TransferVisitante", fields: [visitanteUsuarioId], references: [id], onDelete: Cascade)
  anfitrion Usuario @relation("TransferAnfitrion", fields: [anfitrionUsuarioId], references: [id], onDelete: Cascade)

  @@index([visitanteUsuarioId, estado])
  @@index([anfitrionUsuarioId, estado, fechaLlegada])
}
