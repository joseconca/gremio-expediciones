generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                String    @id @default(uuid())
  email             String    @unique
  nombre            String    @unique
  password          String
  oro               Int       @default(10)
  madera            Int       @default(0)
  piedra            Int       @default(0)
  metal             Int       @default(0)
  baseCoords        Json?
  ultimaMisionElite DateTime?
  ultimaActividad   DateTime?
  fechaCreacion DateTime @default(now())

  edificios Json @default("{\"taberna\": 1, \"herreria\": 0, \"mercado\": 0, \"embajada\": 0}")

  // Relaciones
  personaje        Personaje?
  expedicionActiva ExpedicionActiva?
  historial        RegistroAccion[]
  sesiones         Sesion[]
  mensajesChat     MensajeChat[]
  sugerencias      Sugerencia[]

  // Juego 2.5D
  fechaEmpezar DateTime?
  jugador      Jugador?
  base         Base?
}

model Sesion {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expira    DateTime
  creada    DateTime @default(now())

  @@index([usuarioId])
  @@index([expira])
}

model Personaje {
  id        String  @id @default(uuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  clase              String
  sexo               String               @default("chico")
  nombre             String

  hpActual           Int
  regeneracionDeVida Float
  ultimaRegeneracion DateTime             @default(now())
  estado             String               @default("ocioso")

  velocidadMejoras           Int @default(0)
  capacidadCarruajeMejoras   Int @default(0)

  nivel              Int                  @default(1)
  experiencia        Int                  @default(0)

  inventario         Inventario?
  habilidades        HabilidadAprendida[]
  equipoEquipado     EquipoEquipado?
}

model Inventario {
  id          String    @id @default(uuid())
  personajeId String    @unique
  personaje   Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)

  objetos InventarioObjeto[]
}

model InventarioObjeto {
  id           String @id @default(uuid())
  inventarioId String
  objetoId     String
  cantidad     Int @default(1)
  nivelMejora  Int @default(0)

  inventario Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)

  armaEquipadas      EquipoEquipado[] @relation("ArmaEquipada")
  armaduraEquipadas  EquipoEquipado[] @relation("ArmaduraEquipada")
  accesorioEquipadas EquipoEquipado[] @relation("AccesorioEquipada")

  @@unique([inventarioId, objetoId])
}

model EquipoEquipado {
  id          String @id @default(uuid())
  personajeId String @unique
  personaje   Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)

  armaInventarioId      String?
  armaduraInventarioId  String?
  accesorioInventarioId String?

  arma      InventarioObjeto? @relation("ArmaEquipada", fields: [armaInventarioId], references: [id], onDelete: SetNull)
  armadura  InventarioObjeto? @relation("ArmaduraEquipada", fields: [armaduraInventarioId], references: [id], onDelete: SetNull)
  accesorio InventarioObjeto? @relation("AccesorioEquipada", fields: [accesorioInventarioId], references: [id], onDelete: SetNull)
}

model HabilidadAprendida {
  id          String  @id @default(uuid())
  personajeId String
  habilidadId String
  slot        String?

  personaje Personaje @relation(fields: [personajeId], references: [id], onDelete: Cascade)

  @@unique([personajeId, habilidadId])
  @@unique([personajeId, slot])
}

model ExpedicionActiva {
  id        String  @id @default(uuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo       String
  objetivoId String?
  fase       String
  resultadoFinal     String?

  misionId   String
  enemigoId  String?
  nombre     String
  recompensa Json
  dificultad Int

  hpPerdido          Int      @default(0)
  experienciaGanada  Int      @default(0)

  fechaSalida   DateTime @default(now())
  fechaLlegada  DateTime
  destinoCoords Json

  combateActivo CombateActivo?
}

model CombateActivo {
  id String @id @default(uuid())

  version Int @default(0)

  expedicionId String           @unique
  expedicion   ExpedicionActiva @relation(fields: [expedicionId], references: [id], onDelete: Cascade)

  fase String @default("activo")

  ronda Int @default(1)
  turno String @default("jugador")

  tipo String @default("pve")

 // Solo PvP
  atacanteUsuarioId String?
  defensorUsuarioId String?

  atacanteNombre String?
  defensorNombre String?

  atacanteClase String?
  atacanteSexo String?

  defensorClase String?
  defensorSexo String?

  ultimoTurnoEn DateTime @default(now())

  cooldownsDefensor Json @default("{}")
  efectosDefensor Json @default("[]")

  estadoDefensorAnterior String?

  capacidadCarruaje Int?
  
  // Edificios defensivos
  murallaNivel Int?
  almacenNivel Int?

  enemigoUsuarioId String?

  enemigoId     String?
  enemigoNombre String?

  enemigoHp        Int?
  enemigoHpMaximo  Int?
  enemigoAtaque    Int?
  enemigoDefensa   Int?
  enemigoVelocidad Int?
  enemigoProbCritico Float?
  enemigoDanoCritico Float?
  enemigoNivel Int?

  jugadorHp       Int
  jugadorHpMaximo Int
  jugadorAtaque   Int
  jugadorDefensa  Int
  jugadorVelocidad Int
  jugadorProbCritico Float
  jugadorDanoCritico Float
  jugadorNivel    Int

  ganadorUsuarioId String?
  botinResuelto Boolean @default(false)

  oroGanado         Int @default(0)
  experienciaGanada Int @default(0)

  cooldowns Json @default("{}")
  efectos   Json @default("[]")
  log       Json @default("[]")

  ultimaAccion Json?

  creado      DateTime @default(now())
  actualizado DateTime @updatedAt

  @@index([defensorUsuarioId])
  @@index([atacanteUsuarioId])
  @@index([tipo, fase])
}

model AfinidadComercial {
  id           String @id @default(uuid())
  jugador1Id   String
  jugador2Id   String
  intercambios Int    @default(0)
  afinidad     Int    @default(0)

  @@unique([jugador1Id, jugador2Id])
}

model RegistroAccion {
  id        String  @id @default(uuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo    String // Ej: "EXPEDICION_TERMINADA", "MEJORA_EDIFICIO", "CURACION"
  detalle String // Ej: "El personaje sanó 20 HP en la taberna por 15 de oro"
  fecha   DateTime @default(now())
}

model MensajeChat {
  id        String   @id @default(uuid())
  usuarioId String
  texto     String
  creado    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([creado])
}

model Sugerencia {
  id        String   @id @default(uuid())
  usuarioId String
  titulo    String
  texto     String
  creado    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([creado])
}

// ---------------- Juego 2.5D ----------------

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CANCELADA
}

model Jugador {
  id          String  @id @default(uuid())
  usuarioId   String  @unique
  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nombre      String
  sexo        String
  clase       String  @default("Novato")
  nivel       Int     @default(1)
  experiencia Int     @default(0)
  oro         Int     @default(100)
  saludActual Int     @default(40)
  saludMaxima Int     @default(100)
  ultimoVisto DateTime @default(now())
  ubicacion   Json?
  viajeRegreso Json?
  ubicacionRevision Int @default(0)
  ultimaEliteExitosa DateTime?
  rewardRevision Int @default(0)
  inventarioMundo Json @default("[]")
  equipoMundo Json @default("{\"items\":[],\"receipts\":[]}")
  expedicionesMundo ExpedicionMundo[]
  participacionesMundo ExpedicionParticipante[]

  miembroParty          MiembroParty?
  partyLiderada         Party?             @relation("LiderParty")
  invitacionesEnviadas  InvitacionParty[]  @relation("InvitacionEmisor")
  invitacionesRecibidas InvitacionParty[]  @relation("InvitacionReceptor")
}

model ExpedicionMundo {
  id                String   @id @default(uuid())
  jugadorId         String
  jugador           Jugador  @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  participantes     ExpedicionParticipante[]
  requestId         String   @unique
  // Snapshot autoritativo; el catálogo horario puede caducar durante el viaje.
  mission           Json
  phase             String
  originLat         Float
  originLng         Float
  departureAt       DateTime
  arrivalAt         DateTime
  returnDepartureAt DateTime?
  returnArrivalAt   DateTime?
  enemy             Json?
  enemyHealth       Int
  playerHealth      Int
  playerMaxHealth   Int
  attack            Int
  defense           Int
  playerSpeed       Int      @default(5)
  turn              String   @default("player")
  enemyTurnAt       DateTime?
  lastAction        Json?
  version           Int      @default(0)
  outcome           String?
  log               String   @default("")
  rewardGranted     Boolean  @default(false)
  botin             Json     @default("[]")
  // Sin FK: borrar el receptor no debe borrar el ledger del remitente.
  targetPlayerId    String?

  @@index([jugadorId, phase])
  @@index([jugadorId, departureAt])
}

model Base {
  id        String  @id @default(uuid())
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nombre    String
  lat       Float
  lng       Float
  // [{ "type": "town-hall" | "tavern" | "embassy", "level": number }]
  edificios Json    @default("[]")
  // Derivado de edificios; permite filtrar en SQL.
  embajada  Boolean  @default(false)
  creada    DateTime @default(now())

  @@index([lat, lng])
}

model Party {
  id       String   @id @default(uuid())
  liderId  String   @unique
  lider    Jugador  @relation("LiderParty", fields: [liderId], references: [id])
  creada   DateTime @default(now())

  miembros MiembroParty[]
}

model MiembroParty {
  jugadorId String   @id
  jugador   Jugador  @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  unido     DateTime @default(now())

  @@index([partyId])
}

model InvitacionParty {
  id         String           @id @default(uuid())
  emisorId   String
  emisor     Jugador          @relation("InvitacionEmisor", fields: [emisorId], references: [id], onDelete: Cascade)
  receptorId String
  receptor   Jugador          @relation("InvitacionReceptor", fields: [receptorId], references: [id], onDelete: Cascade)
  estado     EstadoInvitacion @default(PENDIENTE)
  creada     DateTime         @default(now())
  expira     DateTime

  @@index([receptorId, estado])
  @@index([emisorId, estado])
}

model ExpedicionParticipante {
  expedicionId String
  expedicion   ExpedicionMundo @relation(fields: [expedicionId], references: [id], onDelete: Cascade)
  jugadorId    String
  jugador      Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)

  orden        Int
  nombre       String
  nivel        Int
  salud        Int
  saludMaxima  Int
  ataque       Int
  defensa      Int
  velocidad    Int
  botin        Json @default("[]")

  @@id([expedicionId, jugadorId])
  @@index([jugadorId])
  @@index([expedicionId, orden])
}