  "qa": {
    "automated": [
      "exact 512x3840 dimensions",
      "60 exact 128x256 cells",
      "15 rows in canonical order",
      "real alpha transparency",
      "no empty cells",
      "four distinct visible frames per row",
      "cell-boundary clipping checks",
      "source/output SHA-256",
      "baseline/foot position consistency"
    ],
    "visual": [
      "complete 15-row sheet",
      "individual animation strips",
      "readability at in-game size",
      "consistent proportions/materials/palette",
      "no residual background/halo",
      "weapon-ready hand poses",
      "identity preserved across actions"
    ],
    "validatorScript": "scripts/validar-spritesheet-hd.py",
    "validatorUsage": "python scripts/validar-spritesheet-hd.py --sheet <hoja.png> --class-id novato --sex m --report <qa-report.json>",
